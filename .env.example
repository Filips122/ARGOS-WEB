# Copia a .env.local y rellena. .env.local no se versiona.

# --- Wazuh ------------------------------------------------------------------
WAZUH_API_URL=https://<manager>:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://<indexer>:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Solo para el laboratorio, con certificados autofirmados:
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Asistente conversacional -----------------------------------------------
# El chat elige motor solo: CLI de Claude Code (suscripcion) > clave de API >
# palabras clave. Todo esto es OPCIONAL: con Claude Code instalado ya funciona.

# Forzar un motor concreto: cli | api | keywords
ARGOS_CHAT_ENGINE=
# Ruta al CLI de Claude Code, si no se autodetecta.
ARGOS_CLAUDE_CLI=
# Modelo del motor de suscripcion. Por defecto sonnet.
ARGOS_CLAUDE_MODEL=
# Tiempo maximo por consulta (ms) y agentes simultaneos. Por defecto 120000 y 2.
ARGOS_CLAUDE_TIMEOUT_MS=
ARGOS_CLAUDE_MAX_CONCURRENT=
# Motor de API. No hace falta si usas el de suscripcion.
ANTHROPIC_API_KEY=

# --- Servicios auxiliares ---------------------------------------------------
# Sidecar de scoring. Por defecto http://127.0.0.1:8973
ARGOS_SCORER_URL=
# URL que usa el servidor MCP para llamar a esta misma web.
# Por defecto http://127.0.0.1:$PORT
ARGOS_WEB_URL=
# Enriquecimiento de reputacion de IP (opcional).
ABUSEIPDB_API_KEY=
