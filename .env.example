# Copia a .env.local y rellena. .env.local no se versiona.

# --- Wazuh ------------------------------------------------------------------
WAZUH_API_URL=https://<manager>:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://<indexer>:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Solo para el laboratorio, con certificados autofirmados:
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Asistente conversacional -----------------------------------------------
# Habilita el motor de lenguaje natural del chat del panel sobre las
# herramientas MCP. Sin esta clave el chat cae a palabras clave y lo declara.
# Una suscripcion de Claude NO sirve: no expone credencial programatica.
ANTHROPIC_API_KEY=

# --- Servicios auxiliares ---------------------------------------------------
# Sidecar de scoring. Por defecto http://127.0.0.1:8973
ARGOS_SCORER_URL=
# URL que usa el servidor MCP para llamar a esta misma web.
# Por defecto http://127.0.0.1:$PORT
ARGOS_WEB_URL=
# Enriquecimiento de reputacion de IP (opcional).
ABUSEIPDB_API_KEY=
